#!/bin/sh
# Start the fsync'd soak telemetry sampler (must run unattended from boot).

DAEMON=/usr/bin/soak-logger
PIDFILE=/var/run/soak-logger.pid

case "$1" in
  start)
	printf "Starting soak-logger: "
	start-stop-daemon -S -b -q -m -p $PIDFILE -x $DAEMON
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	;;
  stop)
	# Orderly-shutdown marker: a soft `reboot` leaves the SAME PON signature
	# (warm_reset=0x0002 poff=0x0002) as the silent PS_HOLD reset, so PON
	# alone cannot tell them apart.  A boot whose BOOTS entry has no
	# matching clean-stop line ended uncleanly.
	echo "$(date +%s) clean-stop boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)" >> /root/soak/BOOTS
	sync /root/soak/BOOTS 2>/dev/null || sync
	printf "Stopping soak-logger: "
	start-stop-daemon -K -q -p $PIDFILE
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	;;
  restart)
	# Deliberately not "$0 stop": that writes the clean-shutdown marker,
	# and a restart is not a shutdown.  A marker written by a restart made
	# a genuine silent reset look like an orderly reboot in the
	# 2026-08-04 load-test post-mortem.
	start-stop-daemon -K -q -p $PIDFILE
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
