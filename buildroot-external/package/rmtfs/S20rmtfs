#!/bin/sh

DAEMON="rmtfs"
# Serves the modem storage from persistent copies of its partitions:
# see /usr/libexec/citronics-rmtfs. The wrapper execs rmtfs, keeping the pid.
WRAPPER="/usr/libexec/citronics-rmtfs"
PIDFILE="/var/run/$DAEMON.pid"

start() {
        printf 'Starting %s: ' "$DAEMON"
        start-stop-daemon --start --background --make-pidfile \
                --pidfile "$PIDFILE" --exec "$WRAPPER"
        status=$?
        if [ "$status" -eq 0 ]; then
                echo "OK"
        else
                echo "FAIL"
        fi
        return "$status"
}

stop() {
        printf 'Stopping %s: ' "$DAEMON"
        start-stop-daemon --stop --pidfile "$PIDFILE"
        status=$?
        if [ "$status" -eq 0 ]; then
                echo "OK"
        else
                echo "FAIL"
                return "$status"
        fi
        rm -f "$PIDFILE"
        return "$status"
}

restart() {
        stop
        start
}

case "$1" in
        start|stop|restart)
                "$1";;
        reload)
                # Restart, since there is no true "reload" feature.
                restart;;
        *)
                echo "Usage: $0 {start|stop|restart|reload}"
                exit 1
esac
