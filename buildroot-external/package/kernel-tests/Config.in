config BR2_PACKAGE_KERNEL_TESTS
	bool "kernel-tests"
	help
	  Test scripts for verifying kernel features on the
	  Fairphone 2: CPU DVFS frequency scaling, thermal
	  management (including emulated trip-point throttling),
	  IOMMU operation, and SPM gang-rail voltage tracking.
	  Outputs results in TAP v13 format.
