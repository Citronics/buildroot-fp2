#!/usr/bin/env python3
"""limeboard-config: turn the Limeboard header's buses on and off, Raspberry Pi
style.

    limeboard-config                   apply /etc/limeboard/config.txt
    limeboard-config show              list the buses and whether they are on
    limeboard-config enable BUS        turn a bus on: i2c1, i2c0, spi0, spi1
    limeboard-config disable BUS       turn a bus off

The buses are off until /etc/limeboard/config.txt turns them on, with the
lines a Raspberry Pi's config.txt uses:

    dtparam=i2c_arm=on        i2c1: SDA GPIO2 (pin 3), SCL GPIO3 (pin 5)
    dtparam=i2c_vc=on         i2c0: SDA GPIO0 (pin 27), SCL GPIO1 (pin 28)
    dtoverlay=i2c0            the same
    dtparam=spi=on            spi0, /dev/spidev0.0 and 0.1
    dtoverlay=spi0-1cs        spi0 with CE0 only (also spi0-2cs)
    dtoverlay=spi1-1cs        spi1, /dev/spidev1.0 (also spi1-2cs, spi1-3cs)

and, for a kernel driver on a chip select instead of spidev:

    spi0_cs1=mcp3008
    spi1_cs0=mcp2515,irq=25,speed=10000000

The settings go to /etc/modprobe.d/limeboard.conf, for the kernel's dln2
drivers, and apply now when the buses are not in use; otherwise at the next
reset of the board's STM32 or reboot.
"""
import os
import re
import subprocess
import sys

CONFIG = "/etc/limeboard/config.txt"
MODPROBE = "/etc/modprobe.d/limeboard.conf"

# Pi name -> Limeboard dln2 port, and the chip selects of each SPI port
I2C_PORTS = {"i2c1": 0, "i2c0": 1}
SPI_CHIP_SELECTS = {"spi0": 2, "spi1": 3}
# The line enable writes for each bus
ENABLE_LINE = {
    "i2c1": "dtparam=i2c_arm=on",
    "i2c0": "dtoverlay=i2c0",
    "spi0": "dtparam=spi=on",
    "spi1": "dtoverlay=spi1-3cs",
}
DTPARAMS = {"i2c_arm": "i2c1", "i2c": "i2c1", "i2c1": "i2c1", "i2c_vc": "i2c0",
            "i2c0": "i2c0", "spi": "spi0"}
CS_DEVICE = re.compile(r"^(spi[01])_cs([0-3])$")


def warn(message):
    print(f"limeboard-config: {message}", file=sys.stderr)


def read_lines(path=CONFIG):
    try:
        return open(path).read().splitlines()
    except FileNotFoundError:
        return []


def read_config(path=CONFIG):
    return parse(read_lines(path), path)


def parse(lines, path=CONFIG, warn=warn):
    """Return {"i2c": set of Pi names, "spi": {(port, cs): device}}."""
    i2c, spi = set(), {}
    for number, raw in enumerate(lines, 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        key, _, value = line.partition("=")
        key, value = key.strip(), value.strip()
        if key == "dtparam":
            for item in value.split(","):
                name, _, state = item.partition("=")
                bus = DTPARAMS.get(name.strip())
                if bus is None:
                    warn(f"{path}:{number}: unknown dtparam {name.strip()!r}, ignored")
                elif state.strip() in ("on", "true", "yes", "1", ""):
                    _enable(bus, i2c, spi)
                else:
                    _disable(bus, i2c, spi)
        elif key == "dtoverlay":
            overlay = value.split(",")[0].split(":")[0]
            match = re.fullmatch(r"(spi[01])-([123])cs", overlay)
            if overlay == "i2c0":
                i2c.add("i2c0")
            elif match and int(match[2]) <= SPI_CHIP_SELECTS[match[1]]:
                _enable(match[1], i2c, spi, int(match[2]))
            elif overlay:
                warn(f"{path}:{number}: unknown dtoverlay {overlay!r}, ignored")
        elif CS_DEVICE.match(key):
            port, cs = CS_DEVICE.match(key).groups()
            if int(cs) < SPI_CHIP_SELECTS[port]:
                spi[(port, int(cs))] = value or "none"
            else:
                warn(f"{path}:{number}: {port} has no chip select {cs}, ignored")
        else:
            warn(f"{path}:{number}: unknown setting {key!r}, ignored")
    return {"i2c": i2c, "spi": spi}


def _enable(bus, i2c, spi, chip_selects=None):
    if bus in I2C_PORTS:
        i2c.add(bus)
        return
    for cs in range(chip_selects or SPI_CHIP_SELECTS[bus]):
        spi.setdefault((bus, cs), "spidev")


def _disable(bus, i2c, spi):
    if bus in I2C_PORTS:
        i2c.discard(bus)
        return
    for cs in range(SPI_CHIP_SELECTS[bus]):
        spi.pop((bus, cs), None)


def modprobe_options(config):
    ports = sorted(I2C_PORTS[bus] for bus in config["i2c"])
    spi = []
    for bus in ("spi0", "spi1"):
        for cs in range(4):
            spi.append(f"{bus}_cs{cs}={config['spi'].get((bus, cs), 'none')}")
    return (f"# Generated by limeboard-config from {CONFIG}: edit that file.\n"
            f"options i2c_dln2 ports={','.join(map(str, ports)) or '-1'}\n"
            f"options spi_dln2 {' '.join(spi)}\n")


def run(*command):
    return subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def apply(config):
    text = modprobe_options(config)
    try:
        old = open(MODPROBE).read()
    except FileNotFoundError:
        old = None
    if text != old:
        os.makedirs(os.path.dirname(MODPROBE), exist_ok=True)
        with open(MODPROBE, "w") as f:
            f.write(text)
    run("udevadm", "control", "--reload")  # for the next reset of the STM32
    if not os.path.isdir("/sys/bus/usb/drivers/dln2"):
        return
    for module in ("i2c_dln2", "spi_dln2"):
        if os.path.isdir(f"/sys/module/{module}"):
            if not run("rmmod", module):
                warn(f"{module} is in use: the change applies at the next reboot")
                continue
        run("modprobe", module)


def show(config):
    for bus, port in I2C_PORTS.items():
        print(f"{bus}: {'on' if bus in config['i2c'] else 'off'}")
    for bus, count in SPI_CHIP_SELECTS.items():
        devices = [config["spi"].get((bus, cs)) for cs in range(count)]
        if any(devices):
            print(f"{bus}: on, " + ", ".join(f"CE{cs} {d}" for cs, d in enumerate(devices) if d))
        else:
            print(f"{bus}: off")


def buses(config):
    return set(config["i2c"]) | {bus for bus, _ in config["spi"]}


def edit(bus, on):
    """Remove the lines that turn only this bus on, then add its line for on."""
    quiet = lambda message: None
    kept = [raw for raw in read_lines()
            if buses(parse([raw], warn=quiet)) != {bus}]
    if on:
        kept.append(ENABLE_LINE[bus])
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG, "w") as f:
        f.write("\n".join(kept) + "\n")
    if not on and bus in buses(read_config()):
        warn(f"a line of {CONFIG} turns {bus} on with other buses: edit it")


def main(argv):
    if len(argv) == 1:
        apply(read_config())
    elif argv[1:] == ["show"]:
        show(read_config())
    elif len(argv) == 3 and argv[1] in ("enable", "disable") and argv[2] in ENABLE_LINE:
        edit(argv[2], argv[1] == "enable")
        config = read_config()
        apply(config)
        show(config)
    else:
        sys.exit(__doc__.split("\n\n")[1])


if __name__ == "__main__":
    main(sys.argv)
