config BR2_PACKAGE_LIMEBOARD_IO
	bool "limeboard-io"
	depends on BR2_PACKAGE_HAS_UDEV
	select BR2_PACKAGE_DFU_UTIL
	help
	  The Limeboard's STM32 with the Limeboard I/O firmware: its
	  Raspberry Pi style header as standard Linux devices through
	  the kernel's dln2 drivers (GPIO chip "dln2", I2C, SPI, ADC)
	  and a USB serial port for the header UART. Installs the udev
	  rule that binds dln2 to the firmware's USB ID, dfu-util to
	  update the firmware, and /etc/limeboard/config.txt: the I2C
	  and SPI buses are off until it turns them on, with Raspberry
	  Pi config.txt lines (dtparam=i2c_arm=on, dtparam=spi=on...),
	  applied by limeboard-config (installed with python3).

	  Needs CONFIG_MFD_DLN2, GPIO_DLN2, I2C_DLN2, SPI_DLN2 and
	  DLN2_ADC in the kernel.

if BR2_PACKAGE_LIMEBOARD_IO

config BR2_PACKAGE_LIMEBOARD_IO_GPIOZERO
	bool "gpiozero pin factory"
	depends on BR2_PACKAGE_PYTHON3
	depends on BR2_arm # python-gpiozero
	select BR2_PACKAGE_PYTHON_GPIOZERO
	select BR2_PACKAGE_PYTHON_LGPIO
	help
	  The "limeboard" pin factory for gpiozero: Raspberry Pi
	  gpiozero code runs on the header with
	  GPIOZERO_PIN_FACTORY=limeboard. It is gpiozero's lgpio
	  factory on the "dln2" GPIO chip.

config BR2_PACKAGE_LIMEBOARD_IO_PI_COMPAT
	bool "Raspberry Pi library compatibility"
	depends on BR2_PACKAGE_PYTHON3
	depends on BR2_arm # python-gpiozero
	select BR2_PACKAGE_LIMEBOARD_IO_GPIOZERO
	select BR2_PACKAGE_PYTHON_RPI_LGPIO
	select BR2_PACKAGE_PYTHON_SPIDEV
	help
	  Raspberry Pi GPIO code runs on the header without setup:
	  when the Limeboard I/O firmware is present, Python programs
	  start with gpiozero's "limeboard" pin factory selected,
	  RPi.GPIO (rpi-lgpio) on the Limeboard's GPIO chip, and the
	  Limeboard's board definition for Adafruit Blinka, when
	  Blinka is installed, and py-spidev for /dev/spidev.
	  LIMEBOARD_COMPAT=0 turns it off.

comment "gpiozero and Raspberry Pi compatibility need python3"
	depends on !BR2_PACKAGE_PYTHON3
	depends on BR2_arm

endif

comment "limeboard-io needs udev"
	depends on !BR2_PACKAGE_HAS_UDEV
