#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""limeboard-ha: the Limeboard as a Home Assistant device, over MQTT discovery.

Publishes the phone's system state every INTERVAL seconds (psutil), its
motion and light sensors every SENSOR_INTERVAL seconds, and the board's RGB
LED and button, which the Limeboard I/O firmware exposes as GPIO lines and
gpiozero drives through the "limeboard" pin factory.
Settings: /etc/limeboard-ha.conf. See README.md.
"""
import glob
import json
import os
import signal
import socket
import struct
import sys
import threading
import time

import lgpio
import paho.mqtt.client as mqtt
import psutil
from gpiozero import Button, RGBLED
from limeboard_gpiozero import CHIP_LABEL, LimeboardFactory

CONF = os.environ.get("LIMEBOARD_HA_CONF", "/etc/limeboard-ha.conf")


def load_conf():
    conf = {"MQTT_HOST": "", "MQTT_PORT": "1883", "MQTT_USER": "", "MQTT_PASSWORD": "",
            "DISCOVERY_PREFIX": "homeassistant", "INTERVAL": "30", "SENSOR_INTERVAL": "1"}
    with open(CONF) as f:
        for line in f:
            if "=" in line and not line.lstrip().startswith("#"):
                key, value = line.strip().split("=", 1)
                conf[key] = value.strip("'\"")
    return conf


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


conf = load_conf()
serial_no = (read("/sys/block/mmcblk0/device/serial") or read("/etc/machine-id", "")[:8]).replace("0x", "")
NODE = conf.get("NODE_ID", f"limeboard_{serial_no}")
BASE = f"limeboard/{NODE}"
DEVICE = {"identifiers": [NODE], "name": conf.get("DEVICE_NAME", f"Limeboard {serial_no}"),
          "manufacturer": "Citronics", "model": "Limeboard (Fairphone 2)", "sw_version": os.uname().release}

if hasattr(mqtt, "CallbackAPIVersion"):  # paho-mqtt 2
    client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2, client_id=f"{NODE}-{os.getpid()}")
else:  # paho-mqtt 1 (Debian bookworm)
    client = mqtt.Client(client_id=f"{NODE}-{os.getpid()}")


def publish(topic, payload, retain=True):
    client.publish(topic, payload if isinstance(payload, str) else json.dumps(payload), qos=1, retain=retain)


# Home Assistant entities ---------------------------------------------------

def entity(component, obj, name, topic=None, value=None, io_entity=False, **extra):
    cfg = {"name": name, "unique_id": f"{NODE}_{obj}", "device": DEVICE,
           "availability_mode": "all", "availability": [{"topic": f"{BASE}/status"}]}
    if io_entity:  # needs the STM32 with the Limeboard I/O firmware
        cfg["availability"].append({"topic": f"{BASE}/io/status"})
    if topic:
        cfg["state_topic"] = f"{BASE}/{topic}"
    if value:
        cfg["value_template"] = "{{ " + value + " }}"
    cfg.update(extra)
    publish(f"{conf['DISCOVERY_PREFIX']}/{component}/{NODE}/{obj}/config", cfg)


def discovery():
    m = {"state_class": "measurement"}
    entity("sensor", "cpu_temp", "CPU temperature", "state", "value_json.cpu_temp", device_class="temperature", unit_of_measurement="°C", entity_category="diagnostic", **m)
    entity("sensor", "cpu_freq", "CPU frequency", "state", "value_json.cpu_freq", device_class="frequency", unit_of_measurement="MHz", entity_category="diagnostic", **m)
    entity("sensor", "load", "Load", "state", "value_json.load", icon="mdi:chip", entity_category="diagnostic", **m)
    entity("sensor", "supply_voltage", "Supply voltage", "state", "value_json.supply_voltage", device_class="voltage", unit_of_measurement="V", entity_category="diagnostic", **m)
    entity("sensor", "mem_used", "RAM usage", "state", "value_json.mem_used", unit_of_measurement="%", icon="mdi:memory", entity_category="diagnostic", **m)
    entity("sensor", "disk_free", "Disk space left", "state", "value_json.disk_free", device_class="data_size", unit_of_measurement="GB",
           suggested_display_precision=2, entity_category="diagnostic", **m)
    entity("sensor", "uptime", "Uptime", "state", "value_json.uptime", device_class="duration", unit_of_measurement="s", entity_category="diagnostic")
    entity("sensor", "ip", "IP address", "state", "value_json.ip", entity_category="diagnostic", icon="mdi:ip-network")
    entity("button", "reboot", "Reboot", command_topic=f"{BASE}/cmd/reboot", device_class="restart", entity_category="config")
    for axis in "xyz":
        if "accel" in SENSORS:
            entity("sensor", f"accel_{axis}", f"Acceleration {axis}", "sensors", f"value_json.accel_{axis}", unit_of_measurement="m/s²", icon="mdi:axis-arrow", **m)
        if "gyro" in SENSORS:
            entity("sensor", f"gyro_{axis}", f"Rotation {axis}", "sensors", f"value_json.gyro_{axis}", unit_of_measurement="rad/s", icon="mdi:rotate-3d-variant", **m)
        if "mag" in SENSORS:
            entity("sensor", f"mag_{axis}", f"Magnetic field {axis}", "sensors", f"value_json.mag_{axis}", unit_of_measurement="G", icon="mdi:magnet", **m)
    if "accel" in SENSORS:
        entity("sensor", "tilt", "Tilt", "sensors", "(atan2(sqrt(value_json.accel_x ** 2 + value_json.accel_y ** 2), value_json.accel_z) * 180 / pi) | round(1)",
               unit_of_measurement="°", icon="mdi:angle-acute", **m)
    if "light" in SENSORS:
        entity("sensor", "illuminance", "Illuminance", "sensors", "value_json.light", device_class="illuminance", unit_of_measurement="lx", **m)
    if "prox" in SENSORS:
        entity("binary_sensor", "proximity", "Proximity", "sensors", "'ON' if value_json.prox > 0 else 'OFF'")
    # Board LED and button: the LED shows 8 colours, each channel on or off
    entity("binary_sensor", "button", "Button", "io", "'ON' if value_json.btn else 'OFF'", True)
    entity("light", "led", "LED", "io", None, True, schema="template", command_topic=f"{BASE}/cmd/led",
           command_on_template="{% if red is defined %}rgb {{ red }} {{ green }} {{ blue }}{% else %}on{% endif %}",
           command_off_template="off", state_template="{{ 'on' if value_json.led else 'off' }}",
           red_template="{{ value_json.r }}", green_template="{{ value_json.g }}", blue_template="{{ value_json.b }}")


# Phone state -----------------------------------------------------------------

def supply_voltage():
    """VBAT from the PM8941 ADC (in volts), on a board without a battery driver."""
    for name in glob.glob("/sys/bus/iio/devices/iio:device*/name"):
        if "adc@3100" in read(name, ""):
            volts = read(os.path.dirname(name) + "/in_voltage6_input")
            return round(int(volts) / 1e6, 3) if volts else None
    return None


def ip_address():
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        try:
            s.connect(("1.1.1.1", 1))  # no packet is sent: picks the default route
            return s.getsockname()[0]
        except OSError:
            return None


def system_state():
    temps = psutil.sensors_temperatures()
    cpu = [t.current for name, ts in temps.items() if name.startswith("cpu") for t in ts]
    freq = psutil.cpu_freq()
    return {"cpu_temp": max(cpu or [t.current for ts in temps.values() for t in ts] or [None]),
            "cpu_freq": round(freq.current) if freq else None,
            "load": round(psutil.getloadavg()[0], 2),
            "mem_used": psutil.virtual_memory().percent,
            "disk_free": round(psutil.disk_usage("/").free / 1e9, 2),
            "supply_voltage": supply_voltage(),
            "uptime": int(time.time() - psutil.boot_time()),
            "ip": ip_address()}


# The phone's sensors: the ADSP serves them as buffered IIO devices. A sample
# is int32 channels, padding, then an int64 timestamp.
SENSOR_LAYOUT = {"accel": ("accel_x", "accel_y", "accel_z"), "gyro": ("gyro_x", "gyro_y", "gyro_z"),
                 "mag": ("mag_x", "mag_y", "mag_z"), "light": ("light",), "prox": ("prox",)}
SENSORS = {}
for path in glob.glob("/sys/bus/iio/devices/iio:device*"):
    kind = (read(path + "/name") or "").removeprefix("qcom-smgr-")
    if kind in SENSOR_LAYOUT:
        SENSORS[kind] = path


def sensor_loop():
    streams = {}
    for kind, path in SENSORS.items():
        open(path + "/buffer/enable", "w").write("0")
        for en in glob.glob(path + "/scan_elements/in_*_en"):
            open(en, "w").write("1")
        open(path + "/buffer/length", "w").write("1")
        open(path + "/buffer/enable", "w").write("1")
        scale = float((glob.glob(path + "/in_*_scale") and read(glob.glob(path + "/in_*_scale")[0])) or 1)
        size = 24 if len(SENSOR_LAYOUT[kind]) == 3 else 16
        streams[kind] = (os.open("/dev/" + os.path.basename(path), os.O_RDONLY), size, scale)
    while True:
        values = {}
        for kind, (fd, size, scale) in streams.items():
            os.read(fd, size)  # the buffered sample may be old: the next one is fresh
            raw = struct.unpack_from(f"<{len(SENSOR_LAYOUT[kind])}i", os.read(fd, size))
            values.update({k: round(v * scale, 4) for k, v in zip(SENSOR_LAYOUT[kind], raw)})
        client.publish(f"{BASE}/sensors", json.dumps(values), retain=True)
        time.sleep(float(conf["SENSOR_INTERVAL"]))


def sensors_off():
    for path in SENSORS.values():
        open(path + "/buffer/enable", "w").write("0")


# Board LED and button: gpiozero devices on the Limeboard I/O firmware's GPIO
# chip. The chip goes away when the STM32 resets or is updated, and the devices
# are created again when it is back.
io = {"led": None, "rgb": (1, 1, 1), "state": {"led": 0, "r": 0, "g": 0, "b": 0, "btn": 0}}


def publish_io(*_):
    led, button = io["led"], io.get("button")
    if led is not None:
        rgb = tuple(int(c) for c in led.value)
        io["state"].update(led=int(any(rgb)), r=255 * rgb[0], g=255 * rgb[1], b=255 * rgb[2])
    if button is not None:
        io["state"]["btn"] = int(button.is_pressed)
    publish(f"{BASE}/io", io["state"])


def chip_present(factory):
    try:  # fails once the USB device behind the open chip has gone
        return lgpio.gpio_get_chip_info(factory._handle)[3] == CHIP_LABEL
    except lgpio.error:
        return False


def io_loop():
    last_error = None
    while True:
        factory = None
        try:
            factory = LimeboardFactory()
            io["led"] = RGBLED("LED_R", "LED_G", "LED_B", pwm=False, pin_factory=factory)
            io["button"] = Button("BUTTON", pull_up=None, active_state=True, pin_factory=factory)
            io["button"].when_pressed = io["button"].when_released = publish_io
            publish(f"{BASE}/io/status", "online")
            publish_io()
            print("limeboard-ha: LED and button online", flush=True)
            last_error = None
            # The chip is checked often: while the pins of a removed chip stay
            # open, lgpio's event thread spins on them.
            checks = 0
            while chip_present(factory):
                time.sleep(0.2)
                checks += 1
                if checks % 300 == 0:  # every minute
                    publish_io()
        except Exception as e:  # absent, or gone with a USB reset
            if str(e) != last_error:
                print(f"limeboard-ha: LED and button unavailable: {e}", flush=True)
                last_error = str(e)
        publish(f"{BASE}/io/status", "offline")
        for name in ("led", "button"):
            device, io[name] = io.get(name), None
            try:
                device and device.close()
            except Exception:
                pass
        if factory is not None:
            try:
                factory.close()
            except Exception:
                pass
        time.sleep(5)


def set_led(rgb):
    if io["led"] is not None:
        io["led"].value = rgb
        publish_io()


# MQTT ------------------------------------------------------------------------

def on_connect(client, userdata, flags, *_):
    client.subscribe(f"{BASE}/cmd/#")
    discovery()
    publish(f"{BASE}/status", "online")


def on_message(client, userdata, msg):
    cmd, payload = msg.topic.rsplit("/", 1)[1], msg.payload.decode()
    if cmd == "reboot":
        publish(f"{BASE}/status", "offline")
        os.system("reboot")
    elif cmd == "led":
        words = payload.split()
        try:
            if payload == "on":
                set_led(io["rgb"])
            elif payload == "off":
                set_led((0, 0, 0))
            elif len(words) == 4 and words[0] == "rgb":
                # a channel is on from 128: the LED has no brightness control
                rgb = tuple(int(int(w) >= 128) for w in words[1:])
                if any(rgb):
                    io["rgb"] = rgb
                set_led(rgb)
        except Exception as e:
            print(f"limeboard-ha: LED: {e}", flush=True)


def stop(*_):
    sensors_off()
    client.publish(f"{BASE}/status", "offline", qos=1, retain=True).wait_for_publish(2)
    client.disconnect()
    os._exit(0)


def quiet_c_stderr():
    """Keep Python's stderr, send what C libraries write to fd 2 to /dev/null.

    lgpio's C library logs every failed read of a removed chip's events, which
    is thousands of lines each time the STM32 resets.
    """
    sys.stderr = os.fdopen(os.dup(2), "w", buffering=1)
    devnull = os.open(os.devnull, os.O_WRONLY)
    os.dup2(devnull, 2)
    os.close(devnull)


if __name__ == "__main__":
    quiet_c_stderr()
    if not conf["MQTT_HOST"]:
        print(f"limeboard-ha: MQTT_HOST is not set in {CONF}, idle", flush=True)
        signal.pause()
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    if conf["MQTT_USER"]:
        client.username_pw_set(conf["MQTT_USER"], conf["MQTT_PASSWORD"])
    client.will_set(f"{BASE}/status", "offline", qos=1, retain=True)
    client.on_connect, client.on_message = on_connect, on_message
    client.connect_async(conf["MQTT_HOST"], int(conf["MQTT_PORT"]))
    client.loop_start()  # reconnects by itself
    print(f"limeboard-ha: {NODE} -> {conf['MQTT_HOST']}:{conf['MQTT_PORT']}", flush=True)
    threading.Thread(target=io_loop, daemon=True).start()
    if SENSORS:
        threading.Thread(target=sensor_loop, daemon=True).start()
    while True:
        publish(f"{BASE}/state", system_state())
        time.sleep(int(conf["INTERVAL"]))
