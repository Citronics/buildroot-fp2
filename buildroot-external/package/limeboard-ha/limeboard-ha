#!/usr/bin/env python3
"""limeboard-ha: the Limeboard as a Home Assistant device, over MQTT discovery.

Publishes the phone's system state every INTERVAL seconds, its motion and
light sensors every SENSOR_INTERVAL seconds, and the board's RGB LED and
button, which the Limeboard I/O firmware exposes as lines 28-31 of the
"dln2" GPIO chip. Settings: /etc/limeboard-ha.conf.
"""
import glob
import json
import os
import select
import signal
import socket
import struct
import threading
import time

import paho.mqtt.client as mqtt

CONF = os.environ.get("LIMEBOARD_HA_CONF", "/etc/limeboard-ha.conf")


def load_conf():
    conf = {"MQTT_HOST": "", "MQTT_PORT": "1883", "MQTT_USER": "", "MQTT_PASSWORD": "",
            "DISCOVERY_PREFIX": "homeassistant", "INTERVAL": "30", "SENSOR_INTERVAL": "1"}
    with open(CONF) as f:
        for line in f:
            if "=" in line and not line.lstrip().startswith("#"):
                key, value = line.strip().split("=", 1)
                conf[key] = value.strip("'\"")
    return conf


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


conf = load_conf()
serial_no = (read("/sys/block/mmcblk0/device/serial") or read("/etc/machine-id", "")[:8]).replace("0x", "")
NODE = conf.get("NODE_ID", f"limeboard_{serial_no}")
BASE = f"limeboard/{NODE}"
DEVICE = {"identifiers": [NODE], "name": conf.get("DEVICE_NAME", f"Limeboard {serial_no}"),
          "manufacturer": "Citronics", "model": "Limeboard (Fairphone 2)", "sw_version": os.uname().release}

client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2, client_id=f"{NODE}-{os.getpid()}")


def publish(topic, payload, retain=True):
    client.publish(topic, payload if isinstance(payload, str) else json.dumps(payload), qos=1, retain=retain)


# Home Assistant entities ---------------------------------------------------

def entity(component, obj, name, topic=None, value=None, io_entity=False, **extra):
    cfg = {"name": name, "unique_id": f"{NODE}_{obj}", "device": DEVICE,
           "availability_mode": "all", "availability": [{"topic": f"{BASE}/status"}]}
    if io_entity:  # needs the STM32 with the Limeboard I/O firmware
        cfg["availability"].append({"topic": f"{BASE}/io/status"})
    if topic:
        cfg["state_topic"] = f"{BASE}/{topic}"
    if value:
        cfg["value_template"] = "{{ " + value + " }}"
    cfg.update(extra)
    publish(f"{conf['DISCOVERY_PREFIX']}/{component}/{NODE}/{obj}/config", cfg)


def discovery():
    m = {"state_class": "measurement"}
    entity("sensor", "cpu_temp", "CPU temperature", "state", "value_json.cpu_temp", device_class="temperature", unit_of_measurement="°C", **m)
    entity("sensor", "cpu_freq", "CPU frequency", "state", "value_json.cpu_freq", device_class="frequency", unit_of_measurement="MHz", **m)
    entity("sensor", "load", "Load", "state", "value_json.load", icon="mdi:chip", **m)
    entity("sensor", "mem_used", "Memory used", "state", "value_json.mem_used", unit_of_measurement="%", icon="mdi:memory", **m)
    entity("sensor", "supply_voltage", "Supply voltage", "state", "value_json.supply_voltage", device_class="voltage", unit_of_measurement="V", **m)
    entity("sensor", "uptime", "Uptime", "state", "value_json.uptime", device_class="duration", unit_of_measurement="s", entity_category="diagnostic")
    entity("sensor", "ip", "IP address", "state", "value_json.ip", entity_category="diagnostic", icon="mdi:ip-network")
    entity("button", "reboot", "Reboot", command_topic=f"{BASE}/cmd/reboot", device_class="restart", entity_category="config")
    for axis in "xyz":
        if "accel" in SENSORS:
            entity("sensor", f"accel_{axis}", f"Acceleration {axis}", "sensors", f"value_json.accel_{axis}", unit_of_measurement="m/s²", icon="mdi:axis-arrow", **m)
        if "gyro" in SENSORS:
            entity("sensor", f"gyro_{axis}", f"Rotation {axis}", "sensors", f"value_json.gyro_{axis}", unit_of_measurement="rad/s", entity_category="diagnostic", **m)
        if "mag" in SENSORS:
            entity("sensor", f"mag_{axis}", f"Magnetic field {axis}", "sensors", f"value_json.mag_{axis}", unit_of_measurement="G", entity_category="diagnostic", icon="mdi:magnet", **m)
    if "accel" in SENSORS:
        entity("sensor", "tilt", "Tilt", "sensors", "(atan2(sqrt(value_json.accel_x ** 2 + value_json.accel_y ** 2), value_json.accel_z) * 180 / pi) | round(1)",
               unit_of_measurement="°", icon="mdi:angle-acute", **m)
    if "light" in SENSORS:
        entity("sensor", "illuminance", "Illuminance", "sensors", "value_json.light", device_class="illuminance", unit_of_measurement="lx", **m)
    if "prox" in SENSORS:
        entity("binary_sensor", "proximity", "Proximity", "sensors", "'ON' if value_json.prox > 0 else 'OFF'")
    # Board LED and button (GPIO lines): the LED shows 8 colours, on or off
    # per channel
    entity("binary_sensor", "button", "Button", "io", "'ON' if value_json.btn else 'OFF'", True)
    entity("light", "led", "LED", "io", None, True, schema="template", command_topic=f"{BASE}/cmd/led",
           command_on_template="{% if red is defined %}rgb {{ red }} {{ green }} {{ blue }}{% else %}on{% endif %}",
           command_off_template="off", state_template="{{ 'on' if value_json.led else 'off' }}",
           red_template="{{ value_json.r }}", green_template="{{ value_json.g }}", blue_template="{{ value_json.b }}")


# Phone state -----------------------------------------------------------------

def system_state():
    temps = [int(t) for t in map(read, glob.glob("/sys/class/thermal/thermal_zone*/temp")) if t]
    mem = dict(line.split(":") for line in open("/proc/meminfo"))
    total, avail = (int(mem[k].split()[0]) for k in ("MemTotal", "MemAvailable"))
    # VBAT: the battery driver, or the PM8941 ADC on a board without a battery
    volts = None
    for name in glob.glob("/sys/bus/iio/devices/iio:device*/name"):
        if "adc@3100" in read(name, ""):
            volts = read(os.path.dirname(name) + "/in_voltage6_input")
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        try:
            s.connect(("1.1.1.1", 1))  # no packet is sent: picks the default route
            ip = s.getsockname()[0]
        except OSError:
            ip = None
    freq = read("/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq")
    return {"cpu_temp": max(temps) / 1000 if temps else None,
            "cpu_freq": int(freq) // 1000 if freq else None,
            "load": float(read("/proc/loadavg").split()[0]),
            "mem_used": round((total - avail) * 100 / total, 1),
            "supply_voltage": round(int(volts) / 1e6, 3) if volts else None,
            "uptime": int(float(read("/proc/uptime").split()[0])), "ip": ip}


# The phone's sensors: the ADSP serves them as buffered IIO devices. A sample
# is int32 channels, padding, then an int64 timestamp.
SENSOR_LAYOUT = {"accel": ("accel_x", "accel_y", "accel_z"), "gyro": ("gyro_x", "gyro_y", "gyro_z"),
                 "mag": ("mag_x", "mag_y", "mag_z"), "light": ("light",), "prox": ("prox",)}
SENSORS = {}
for path in glob.glob("/sys/bus/iio/devices/iio:device*"):
    kind = (read(path + "/name") or "").removeprefix("qcom-smgr-")
    if kind in SENSOR_LAYOUT:
        SENSORS[kind] = path


def sensor_loop():
    streams = {}
    for kind, path in SENSORS.items():
        open(path + "/buffer/enable", "w").write("0")
        for en in glob.glob(path + "/scan_elements/in_*_en"):
            open(en, "w").write("1")
        open(path + "/buffer/length", "w").write("1")
        open(path + "/buffer/enable", "w").write("1")
        scale = float((glob.glob(path + "/in_*_scale") and read(glob.glob(path + "/in_*_scale")[0])) or 1)
        size = 24 if len(SENSOR_LAYOUT[kind]) == 3 else 16
        streams[kind] = (os.open("/dev/" + os.path.basename(path), os.O_RDONLY), size, scale)
    while True:
        values = {}
        for kind, (fd, size, scale) in streams.items():
            os.read(fd, size)  # the buffered sample may be old: the next one is fresh
            raw = struct.unpack_from(f"<{len(SENSOR_LAYOUT[kind])}i", os.read(fd, size))
            values.update({k: round(v * scale, 4) for k, v in zip(SENSOR_LAYOUT[kind], raw)})
        client.publish(f"{BASE}/sensors", json.dumps(values), retain=True)
        time.sleep(float(conf["SENSOR_INTERVAL"]))


def sensors_off():
    for path in SENSORS.values():
        open(path + "/buffer/enable", "w").write("0")


# Board LED and button: GPIO lines 28-31 of the "dln2" chip (sysfs) ------------

LED_LINES, BUTTON_LINE = (28, 29, 30), 31
io = {"base": None, "rgb": (1, 1, 1), "state": {"led": 0, "r": 0, "g": 0, "b": 0, "btn": 0}}


def gpio(line):
    return f"/sys/class/gpio/gpio{io['base'] + line}"


def gpio_setup(line, direction, edge=None):
    if not os.path.exists(gpio(line)):
        with open("/sys/class/gpio/export", "w") as f:
            f.write(str(io["base"] + line))
    with open(gpio(line) + "/direction", "w") as f:
        f.write(direction)
    if edge:
        with open(gpio(line) + "/edge", "w") as f:
            f.write(edge)


def set_led(rgb):
    for line, on in zip(LED_LINES, rgb):
        with open(gpio(line) + "/value", "w") as f:
            f.write("1" if on else "0")
    if any(rgb):
        io["rgb"] = rgb
    io["state"].update(led=int(any(rgb)), r=255 * rgb[0], g=255 * rgb[1], b=255 * rgb[2])
    publish(f"{BASE}/io", io["state"])


def io_loop():
    while True:
        try:
            chips = [c for c in glob.glob("/sys/class/gpio/gpiochip*") if read(c + "/label") == "dln2"]
            if not chips:
                raise OSError("no Limeboard I/O")
            io["base"] = int(read(chips[0] + "/base"))
            for line in LED_LINES:
                gpio_setup(line, "out")
            gpio_setup(BUTTON_LINE, "in", "both")
            set_led((0, 0, 0))
            publish(f"{BASE}/io/status", "online")
            with open(gpio(BUTTON_LINE) + "/value") as f:
                poller = select.poll()
                poller.register(f, select.POLLPRI | select.POLLERR)
                while True:  # an edge, or every minute
                    f.seek(0)
                    io["state"]["btn"] = int(f.read().strip())
                    publish(f"{BASE}/io", io["state"])
                    poller.poll(60000)
        except (OSError, ValueError):
            pass  # absent, or gone with a USB reset
        io["base"] = None
        publish(f"{BASE}/io/status", "offline")
        time.sleep(5)


# MQTT ------------------------------------------------------------------------

def on_connect(client, userdata, flags, reason, properties):
    client.subscribe(f"{BASE}/cmd/#")
    discovery()
    publish(f"{BASE}/status", "online")


def on_message(client, userdata, msg):
    cmd, payload = msg.topic.rsplit("/", 1)[1], msg.payload.decode()
    if cmd == "reboot":
        publish(f"{BASE}/status", "offline")
        os.system("reboot")
    elif cmd == "led" and io["base"] is not None:
        words = payload.split()
        try:
            if payload == "on":
                set_led(io["rgb"])
            elif payload == "off":
                set_led((0, 0, 0))
            elif len(words) == 4 and words[0] == "rgb":
                set_led(tuple(int(int(w) >= 128) for w in words[1:]))  # on from 128
        except (OSError, ValueError):
            pass


def stop(*_):
    sensors_off()
    client.publish(f"{BASE}/status", "offline", qos=1, retain=True).wait_for_publish(2)
    client.disconnect()
    os._exit(0)


if __name__ == "__main__":
    if not conf["MQTT_HOST"]:
        print(f"limeboard-ha: MQTT_HOST is not set in {CONF}, idle", flush=True)
        signal.pause()
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    if conf["MQTT_USER"]:
        client.username_pw_set(conf["MQTT_USER"], conf["MQTT_PASSWORD"])
    client.will_set(f"{BASE}/status", "offline", qos=1, retain=True)
    client.on_connect, client.on_message = on_connect, on_message
    client.connect_async(conf["MQTT_HOST"], int(conf["MQTT_PORT"]))
    client.loop_start()  # reconnects by itself
    print(f"limeboard-ha: {NODE} -> {conf['MQTT_HOST']}:{conf['MQTT_PORT']}", flush=True)
    threading.Thread(target=io_loop, daemon=True).start()
    if SENSORS:
        threading.Thread(target=sensor_loop, daemon=True).start()
    while True:
        publish(f"{BASE}/state", system_state())
        time.sleep(int(conf["INTERVAL"]))
