config BR2_PACKAGE_LIMEBOARD_HA
	bool "limeboard-ha"
	depends on BR2_PACKAGE_PYTHON3
	depends on BR2_PACKAGE_HAS_UDEV # limeboard-io
	depends on BR2_arm # python-gpiozero
	select BR2_PACKAGE_PYTHON3_SSL # paho-mqtt imports ssl
	select BR2_PACKAGE_PYTHON_PAHO_MQTT
	select BR2_PACKAGE_PYTHON_PSUTIL
	select BR2_PACKAGE_LIMEBOARD_IO
	select BR2_PACKAGE_LIMEBOARD_IO_GPIOZERO
	help
	  Makes the Limeboard a Home Assistant device through MQTT
	  discovery: the phone's system state (psutil) and sensors,
	  and the board's RGB LED and button (gpiozero on the
	  Limeboard I/O firmware). Configured in
	  /etc/limeboard-ha.conf.

comment "limeboard-ha needs python3 and udev"
	depends on BR2_arm
	depends on !BR2_PACKAGE_PYTHON3 || !BR2_PACKAGE_HAS_UDEV
