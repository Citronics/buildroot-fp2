# extlinux.conf for RAUC Slot B
# This file is used in boot-b partition
#
# Configuration for lk2nd RAUC integration (using base device + offsets)
rauc_uboot_part mmcblk0p20
rauc_uboot_offset 0x10000
rauc_uboot_size 0x20000

# Boot slot offsets within the same base device
rauc_boot_offset_a 0x00100000   # 1 MiB
rauc_boot_offset_b 0x04100000   # 1 MiB + 64 MiB

timeout 1
default linux
menu title Lemon RAUC Slot B

label linux
	kernel /zImage
	fdt /qcom-msm8974pro-fairphone-fp2.dtb
	initrd /initramfs.gz
	append earlycon=msm_serial_dm,0xf991e000 msm.vram=192m msm.allow_vram_carveout=1 fbcon=rotate:1 fbcon=font:TER16x32 bootpart=/dev/mmcblk0p20p2 rootfs=/dev/mmcblk0p20p6 rauc.slot=B
