# fw_env.config - Configuration for fw_printenv/fw_setenv tools
#
# This file configures access to the U-Boot environment stored in the
# userdata partition, as used by the modified lk2nd bootloader.
#
# Format: device offset size sector_size
# - device: block device containing U-Boot environment
# - offset: byte offset within device (0x10000 = 64KB)
# - size: environment size in bytes (0x20000 = 128KB)
# - sector_size: erase block size (0x1000 = 4KB for eMMC)

# U-Boot environment location (must match lk2nd extlinux.conf configuration)
/dev/mmcblk0p20  0x10000  0x20000  0x1000
