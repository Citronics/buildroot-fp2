#!/bin/sh

DAEMON=/usr/bin/rauc
NAME=rauc
DESC="RAUC Update Service"
PIDFILE=/var/run/rauc.pid

init_uboot_env() {
    if ! fw_printenv BOOT_ORDER >/dev/null 2>&1; then
        echo "Initializing U-Boot environment for RAUC..."
        fw_setenv BOOT_ORDER "A B"
        fw_setenv BOOT_A_LEFT "3"
        fw_setenv BOOT_B_LEFT "0"
        echo "U-Boot environment initialized (Slot A active)"
    fi
}

start() {
    echo "Starting $DESC..."
    mkdir -p /data/rauc

    # Initialize U-Boot environment if needed
    if [ ! -f /data/rauc/uboot_env_init_done ]; then
        init_uboot_env
        touch /data/rauc/uboot_env_init_done
    fi

    # Mark current slot good if needed
    echo "Checking current slot..."
    eval "$($DAEMON --output-format=shell status 2>/dev/null)"
    BOOTNAME="$RAUC_SYSTEM_BOOTED_BOOTNAME"

    if [ -n "$BOOTNAME" ]; then
        for slot_num in $RAUC_SLOTS; do
            eval "slot_state=\$RAUC_SLOT_STATE_${slot_num}"
            eval "slot_class=\$RAUC_SLOT_CLASS_${slot_num}"
            if [ "$slot_state" = "booted" ] && [ "$slot_class" = "rootfs" ]; then
                eval "BOOT_STATUS=\$RAUC_SLOT_BOOT_STATUS_${slot_num}"
                break
            fi
        done

        if [ "$BOOT_STATUS" != "good" ]; then
            echo "Marking slot $BOOTNAME as good..."
            $DAEMON status mark-good 2>/dev/null || echo "Warning: Failed to mark slot good"
        fi
    fi

    # Start RAUC D-Bus daemon if not running
    if pidof rauc >/dev/null; then
        echo "RAUC daemon already running."
    else
        echo "Launching RAUC D-Bus service..."
        $DAEMON service &
        echo $! > "$PIDFILE"
    fi
    echo "$NAME started."
}

stop() {
    echo "Stopping $DESC..."
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null && rm -f "$PIDFILE"
    else
        killall $NAME 2>/dev/null
    fi
    echo "$NAME stopped."
}

status() {
    echo "=== RAUC Status ==="
    $DAEMON status
    echo
    echo "=== U-Boot Environment ==="
    echo "BOOT_ORDER: $(fw_printenv -n BOOT_ORDER 2>/dev/null || echo 'not set')"
    echo "BOOT_A_LEFT: $(fw_printenv -n BOOT_A_LEFT 2>/dev/null || echo 'not set')"
    echo "BOOT_B_LEFT: $(fw_printenv -n BOOT_B_LEFT 2>/dev/null || echo 'not set')"
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart|reload) stop; start ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac

exit 0
