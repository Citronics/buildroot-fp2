#!/bin/sh

DAEMON=/usr/bin/rauc
NAME=rauc
DESC="RAUC Update Service"
PIDFILE=/var/run/rauc.pid

# Determine the actually booted slot from /proc/mounts (more reliable than RAUC)
get_booted_slot() {
    local root_dev=$(awk '$2 == "/" {print $1}' /proc/mounts)
    case "$root_dev" in
        *mmcblk0p20p5*) echo "A" ;;  # rootfs.0
        *mmcblk0p20p6*) echo "B" ;;  # rootfs.1
        *) echo "unknown" ;;
    esac
}

init_uboot_env() {
    if ! fw_printenv BOOT_ORDER >/dev/null 2>&1; then
        echo "Initializing U-Boot environment for RAUC..."
        fw_setenv BOOT_ORDER "B A"  # Prefer B by default (secondary slot)
        fw_setenv BOOT_A_LEFT "3"
        fw_setenv BOOT_B_LEFT "3"
        echo "U-Boot environment initialized (Slot B preferred)"
    fi
}

start() {
    echo "Starting $DESC..."
    mkdir -p /mnt/data/rauc

    # Initialize U-Boot environment if needed
    if [ ! -f /mnt/data/rauc/uboot_env_init_done ]; then
        init_uboot_env
        touch /mnt/data/rauc/uboot_env_init_done
    fi

    # Determine the booted slot (reliable method)
    BOOTNAME=$(get_booted_slot)
    if [ "$BOOTNAME" = "unknown" ]; then
        echo "Warning: Could not determine booted slot from /proc/mounts"
        # Fallback: use RAUC reported bootname (may be stale)
        BOOTNAME="$($DAEMON --output-format=shell status 2>/dev/null | awk -F"'" '/^RAUC_SYSTEM_BOOTED_BOOTNAME=/ {print $2}')"
    fi

    # Mark the current booted slot as good if needed (without relying on indices)
    if [ -n "$BOOTNAME" ]; then
        echo "Current slot: $BOOTNAME"
        # Inspect RAUC state in shell format and find the rootfs mounted at /
        eval "$($DAEMON --output-format=shell status 2>/dev/null)"
        CUR_STATUS=""
        for n in $RAUC_SLOTS; do
            eval "clazz=\$RAUC_SLOT_CLASS_${n}"
            eval "mp=\$RAUC_SLOT_MOUNTPOINT_${n}"
            if [ "$clazz" = "rootfs" ] && [ "$mp" = "/" ]; then
                eval "CUR_STATUS=\$RAUC_SLOT_BOOT_STATUS_${n}"
                break
            fi
        done

        if [ "$CUR_STATUS" != "good" ]; then
            echo "Marking current booted slot as good..."
            if $DAEMON status mark-good; then
                fw_setenv "BOOT_${BOOTNAME}_LEFT" "3"
            else
                echo "Warning: Failed to mark slot $BOOTNAME as good"
            fi
        fi
    fi

    # Do not start RAUC daemon here: it is D-Bus activated and will be launched on demand
    echo "rauc started."
}

stop() {
    echo "Stopping $DESC..."
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null && rm -f "$PIDFILE"
    else
        killall $NAME 2>/dev/null
    fi
    echo "$NAME stopped."
}

status() {
    echo "=== RAUC Status ==="
    $DAEMON status
    echo
    echo "=== U-Boot Environment ==="
    fw_printenv BOOT_ORDER BOOT_A_LEFT BOOT_B_LEFT
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart|reload) stop; start ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac

exit 0
