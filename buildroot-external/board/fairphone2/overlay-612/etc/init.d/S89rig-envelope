#!/bin/sh
# Apply the carrier rig's supply-aware CPU envelope, then supervise VPH.
#
# Runs before S90soak-logger so a soak always starts inside the envelope.
# Harmless on a real phone: without /etc/rig-envelope.conf.enable it does
# nothing, because a phone has a cell to absorb load steps and wants its full
# frequency range.

DAEMON=/usr/bin/rig-envelope
PIDFILE=/var/run/rig-envelope.pid
ENABLE=/etc/rig-envelope.conf

case "$1" in
  start)
	if [ ! -r "$ENABLE" ]; then
		echo "rig-envelope: no $ENABLE, not a rig - skipping"
		exit 0
	fi
	# Gate on the HARDWARE, not just on a config file: this overlay is
	# shared, so $ENABLE ships in phone images too and keying on it alone
	# would cap a real phone's frequencies by core count.  A device with a
	# battery has a cell to absorb load steps and wants its full range, so
	# the envelope is for battery-less fixtures only.
	for p in /sys/class/power_supply/*/present; do
		[ -r "$p" ] || continue
		if [ "$(cat "$p" 2>/dev/null)" = 1 ]; then
			echo "rig-envelope: battery present - not a rig, skipping"
			exit 0
		fi
	done
	printf "Starting rig-envelope: "
	start-stop-daemon -S -b -q -m -p $PIDFILE -x $DAEMON
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	;;
  stop)
	printf "Stopping rig-envelope: "
	start-stop-daemon -K -q -p $PIDFILE
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	;;
  restart)
	start-stop-daemon -K -q -p $PIDFILE
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
